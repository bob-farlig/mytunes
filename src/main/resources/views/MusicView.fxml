          <TableColumn prefWidth="75.0" text="Artist" />
            <TableColumn prefWidth="75.0" text="Time" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <TableView layoutX="15.0" layoutY="87.0" prefHeight="268.0" prefWidth="259.0">
